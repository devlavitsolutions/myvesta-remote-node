#!/bin/bash
# info: add OpenLiteSpeed virtual host for domain
# options: USER DOMAIN
#
# The function integrates a user's domain into OpenLiteSpeed,
# mapping it to both Default (HTTP) and DefaultSSL (HTTPS) listeners.

#----------------------------------------------------------#
#                    Variable & Function                   #
#----------------------------------------------------------#

VESTA='/usr/local/vesta'
export VESTA

# Argument definition
user=$1
domain=$2

# Includes
source $VESTA/func/main.sh
source $VESTA/conf/vesta.conf

# LiteSpeed paths
LSWS_ROOT="/usr/local/lsws"
CONF_DIR="$LSWS_ROOT/conf"
HTTPD_CONF="$CONF_DIR/httpd_config.conf"
LISTENERS=("Default" "Defaultssl")

#----------------------------------------------------------#
#                        Checks                            #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                        Action                            #
#----------------------------------------------------------#

# Paths
VHOSTS_DIR="$CONF_DIR/vhosts/$domain"
VH_CONF="$VHOSTS_DIR/vhconf.conf"
VH_ROOT="/home/$user/web/$domain"
DOCROOT="$VH_ROOT/public_html"

echo "Integrating domain '$domain' for user '$user' into OpenLiteSpeed..."

# Create directories
for dir in "$VHOSTS_DIR" "$DOCROOT"; do
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
        echo "Created directory: $dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# Create virtual host config
cat > "$VH_CONF" <<EOF
docRoot                   $DOCROOT
enableScript              1
restrained                1

<errorlog $domain>
  logLevel                ERROR
</errorlog>

<accesslog $domain>
  logFormat               "%h %l %u %t \"%r\" %>s %b"
</accesslog>
EOF
echo "Created virtual host config: $VH_CONF"

# Add virtualHost section if not present
if ! grep -q "virtualHost $domain" "$HTTPD_CONF"; then
    cat >> "$HTTPD_CONF" <<EOF

virtualHost $domain {
  vhRoot                  $VH_ROOT
  configFile              $VH_CONF
  allowSymbolLink         1
  enableScript            1
  restrained              1
}
EOF
    echo "Added virtualHost block for '$domain'"
else
    echo "VirtualHost '$domain' already exists in httpd_config.conf"
fi

# Map domain to Default and DefaultSSL listeners
for LISTENER_NAME in "${LISTENERS[@]}"; do
    if grep -q "listener $LISTENER_NAME" "$HTTPD_CONF"; then
        # Ensure domain not already mapped
        if ! awk "/listener $LISTENER_NAME/,/}/" "$HTTPD_CONF" | grep -q "map $domain $domain"; then
            sed -i "/listener $LISTENER_NAME {/a \ \ map $domain $domain" "$HTTPD_CONF"
            echo "Mapped '$domain' to listener '$LISTENER_NAME'"
        else
            echo "Domain '$domain' already mapped in listener '$LISTENER_NAME'"
        fi
    else
        echo "Listener '$LISTENER_NAME' not found in httpd_config.conf, skipping."
    fi
done

# Permissions
chmod -R o+rX "$DOCROOT"
echo "Adjusted permissions for $DOCROOT (world-readable)"

# Reload OLS
echo "Reloading OpenLiteSpeed..."
systemctl reload lsws
check_result $? "OpenLiteSpeed reload failed"

echo "✅ Domain '$domain' integrated successfully for both HTTP and HTTPS."

#----------------------------------------------------------#
#                         Exit                             #
#----------------------------------------------------------#
exit 0
