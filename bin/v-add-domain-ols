#!/bin/bash
# v-add-domain-ols <domain> <user>
# Integrates a new domain into OpenLiteSpeed (MyVesta environment),
# mapping it to both Default (HTTP) and DefaultSSL (HTTPS) listeners.

set -euo pipefail
IFS=$'\n\t'

# --- CONFIG ---
LSWS_ROOT="/usr/local/lsws"
CONF_DIR="$LSWS_ROOT/conf"
HTTPD_CONF="$CONF_DIR/httpd_config.conf"
LISTENERS=("Default" "DefaultSSL")

# --- INPUT ---
VH_NAME="${1:-}"
USER_NAME="${2:-}"

# --- CHECK INPUT ---
if [[ -z "$VH_NAME" || -z "$USER_NAME" ]]; then
  echo "Usage: $0 <domain> <user>"
  exit 1
fi

# --- PATHS ---
VHOSTS_DIR="$CONF_DIR/vhosts/$VH_NAME"
VH_CONF="$VHOSTS_DIR/vhconf.conf"
VH_ROOT="/home/$USER_NAME/web/$VH_NAME"
DOCROOT="$VH_ROOT/public_html"

echo "Adding OpenLiteSpeed vhost for '$VH_NAME' (user: $USER_NAME)"

# --- CREATE DIRECTORIES ---
for dir in "$VHOSTS_DIR" "$DOCROOT"; do
  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir"
    echo "Created directory: $dir"
  else
    echo "Directory already exists: $dir"
  fi
done

# --- GENERATE VH CONFIG ---
cat > "$VH_CONF" <<EOF
docRoot                   $DOCROOT
enableScript              1
restrained                1

<errorlog $VH_NAME>
  logLevel                ERROR
</errorlog>

<accesslog $VH_NAME>
  logFormat               "%h %l %u %t \"%r\" %>s %b"
</accesslog>
EOF
echo "Created virtual host config: $VH_CONF"

# --- ADD <virtualHost> TO HTTPD_CONF ---
if ! grep -q "virtualHost $VH_NAME" "$HTTPD_CONF"; then
  cat >> "$HTTPD_CONF" <<EOF

virtualHost $VH_NAME {
  vhRoot                  "$VH_ROOT"
  configFile              "$VH_CONF"
  allowSymbolLink         1
  enableScript            1
  restrained              1
}
EOF
  echo "Added virtualHost block for '$VH_NAME'"
else
  echo "VirtualHost '$VH_NAME' already exists in httpd_config.conf"
fi

# --- MAP DOMAIN TO LISTENERS ---
for LISTENER_NAME in "${LISTENERS[@]}"; do
  if grep -q "listener $LISTENER_NAME" "$HTTPD_CONF"; then
    if ! grep -q "map $VH_NAME $VH_NAME" "$HTTPD_CONF" | grep -q "$LISTENER_NAME"; then
      sed -i "/listener $LISTENER_NAME {/a \ \ map $VH_NAME $VH_NAME" "$HTTPD_CONF"
      echo "Mapped '$VH_NAME' to listener '$LISTENER_NAME'"
    else
      echo "Domain '$VH_NAME' already mapped in listener '$LISTENER_NAME'"
    fi
  else
    echo "Listener '$LISTENER_NAME' not found in httpd_config.conf, skipping."
  fi
done

# --- PERMISSIONS ---
chmod -R o+rX "$DOCROOT"
echo "Adjusted permissions for $DOCROOT (world-readable)"

# --- RELOAD OLS ---
echo "Reloading OpenLiteSpeed..."
systemctl reload lsws
echo "Domain '$VH_NAME' integrated successfully for both HTTP and HTTPS."
echo "Check OLS WebAdmin GUI to confirm both listeners."
