#!/bin/bash
set -e

# CONFIG
APACHE_SERVICE="apache2"
OLS_SERVICE="lsws"

echo "=== Switching from LiteSpeed to Apache ==="

# 1. Stop LiteSpeed
echo "Stopping LiteSpeed..."
systemctl stop "$OLS_SERVICE" || true
systemctl disable "$OLS_SERVICE" || true

# 2. Start Apache
echo "Starting Apache..."
systemctl enable "$APACHE_SERVICE" || true
systemctl start "$APACHE_SERVICE"

if systemctl is-active --quiet "$APACHE_SERVICE"; then
    echo "Apache started successfully."
else
    echo "Apache failed to start!"
    exit 1
fi

# 3. Confirm which process has port 80
echo "Port 80 is now handled by:"
ss -ltnp | grep ':80' || echo "No process on port 80!"
