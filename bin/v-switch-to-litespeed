#!/bin/bash
set -e

# CONFIG
APACHE_SERVICE="apache2"
APACHE_VHOST_DIR="/home/*/conf/web"
OLS_SERVICE="lsws"
OLS_VHOST_DIR="/usr/local/lsws/conf/vhosts"
OLS_CONF_MAIN="/usr/local/lsws/conf/httpd_config.conf"
OLS_LISTENER_NAME="Default"

echo "=== Switching from Apache to LiteSpeed ==="

# 1. Stop Apache
echo "Stopping Apache..."
systemctl stop "$APACHE_SERVICE" || true
systemctl disable "$APACHE_SERVICE" || true

# 2. Make sure LiteSpeed main conf has listener for :80
if ! grep -q "listener $OLS_LISTENER_NAME" "$OLS_CONF_MAIN"; then
    echo "Adding $OLS_LISTENER_NAME listener to LiteSpeed config..."
    cat <<EOF >> "$OLS_CONF_MAIN"

listener $OLS_LISTENER_NAME {
  address                 *:80
  secure                  0
}
EOF
fi

# 3. Sync Virtual Hosts from Apache to LiteSpeed
echo "Syncing Virtual Hosts from Apache configs..."
mkdir -p "$OLS_VHOST_DIR"

for user_conf in $APACHE_VHOST_DIR; do
    user=$(basename "$(dirname "$user_conf")")
    for vhost_conf in "$user_conf"/s*.conf; do
        [[ -f "$vhost_conf" ]] || continue

        server_name=$(grep -i "ServerName" "$vhost_conf" | awk '{print $2}' | head -n1)
        doc_root=$(grep -i "DocumentRoot" "$vhost_conf" | awk '{print $2}' | head -n1)

        if [[ -n "$server_name" && -n "$doc_root" ]]; then
            vhost_dir="$OLS_VHOST_DIR/$server_name"
            mkdir -p "$vhost_dir"
            vhost_conf_file="$vhost_dir/vhconf.conf"

            # Create vhost config if not exists
            if [[ ! -f "$vhost_conf_file" ]]; then
                echo "Creating LiteSpeed vhost for $server_name..."
                cat <<EOF > "$vhost_conf_file"
docRoot                  $doc_root
vhDomain                 $server_name
enableGzip               1
EOF
            fi

            # Ensure vhost is in main config and mapped to listener
            if ! grep -q "virtualhost $server_name" "$OLS_CONF_MAIN"; then
                echo "Adding $server_name to main LiteSpeed config..."
                cat <<EOF >> "$OLS_CONF_MAIN"

virtualhost $server_name {
  vhRoot                  $vhost_dir/
  configFile              $vhost_conf_file
}
listener $OLS_LISTENER_NAME {
  map $server_name $server_name
}
EOF
            fi
        fi
    done
done

# 4. Start LiteSpeed
echo "Starting LiteSpeed..."
systemctl enable "$OLS_SERVICE" || true
systemctl start "$OLS_SERVICE"

if systemctl is-active --quiet "$OLS_SERVICE"; then
    echo "LiteSpeed started successfully."
else
    echo "LiteSpeed failed to start!"
    exit 1
fi

# 5. Confirm which process has port 80
echo "Port 80 is now handled by:"
ss -ltnp | grep ':80' || echo "No process on port 80!"
